<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/ui">
  <!-- WiX v4 uses Package as the root element instead of Product -->
  <Package Name="Water-Chan" 
           Manufacturer="AzuritilDev" 
           Version="$(var.BuildVersion)" 
           UpgradeCode="D70FBB92-37B7-4724-A369-C0DF1F3D21DB"
           Scope="perMachine">
    
    <!-- Enforce a clean upgrade path when installing newer versions -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Water-Chan is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!-- Defining the icon, the ID ends with '.exe' to match the wanted binary shortcut type  -->
    <Icon Id="AppIconReference.exe" SourceFile="app_icon.ico" />

    <!-- Core App Architecture Layout -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AzuriteFolder" Name="AzuritilDev">
        <Directory Id="INSTALLFOLDER" Name="Water-Chan" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Water-Chan"/>
    </StandardDirectory>

    <!-- Component Group referencing PyInstaller's output binary -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutableComponent" Guid="*">
        <!-- Source maps directly to the PyInstaller output directory -->
        <File Id="MainEXE" Source="dist\Water-Chan.exe" KeyPath="yes">
          <!-- Creates a Start Menu shortcut on installation -->
          <Shortcut Id="StartMenuShortcut" 
                    Directory="ApplicationProgramsFolder" 
                    Name="Water-Chan" 
                    Icon="AppIconReference.exe"
                    Advertise="yes" />
                    
        </File>
      </Component>
    </ComponentGroup>

    <!-- Feature telling Windows Installer to include the component group -->
    <Feature Id="MainFeature" Title="Water-Chan Installation" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>
